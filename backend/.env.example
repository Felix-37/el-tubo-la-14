# Copiar este archivo como .env y poner los valores reales.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=el_tubo_la_14

# Secretos JWT: dos cadenas distintas de 128 caracteres hex (512 bits).
# Generar cada una con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Vida de los tokens (s, m, h, d). Access corto; refresh para renovar la sesión.
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=1d

# Costo de bcrypt (2^costo rondas). El código fuerza un mínimo de 12.
BCRYPT_COST=12
# Longitud mínima de las claves nuevas. El código fuerza un mínimo de 8.
PASSWORD_MIN_LENGTH=8
# Intentos de login por minuto y por IP (frena la fuerza bruta).
LOGIN_INTENTOS_POR_MINUTO=20

# Primer usuario del sistema (npm run seed:admin).
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_NOMBRE=Administrador El Tubo La 14
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CLAVE=